{
  "name": "cfb27-coaching-carousel-editor",
  "version": "0.1.0",
  "description": "Desktop editor for College Football 27 Coaching Carousel job offers.",
  "main": "src/app.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win portable"
  },
  "build": {
    "appId": "community.cfb27.coaching-carousel-editor",
    "productName": "CFB27 Coaching Carousel Editor",
    "asar": true,
    "compression": "maximum",
    "afterPack": "scripts/afterPack.js",
    "files": [
      "src/**/*",
      "Resources/**/*",
      "assets/**/*",
      "node_modules/**/*",
      "!node_modules/electron/**/*",
      "!node_modules/electron-builder/**/*",
      "!node_modules/electron-winstaller/**/*",
      "!node_modules/app-builder-lib/**/*",
      "!node_modules/@electron/**/*",
      "!node_modules/@electron-internal/**/*",
      "!node_modules/node-gyp/**/*",
      "!node_modules/postject/**/*",
      "!node_modules/pkijs/**/*",
      "!node_modules/tar/**/*",
      "!node_modules/undici/**/*",
      "!node_modules/ajv/**/*",
      "!node_modules/lodash/**/*",
      "!node_modules/lucide-static/font/**/*",
      "!node_modules/lucide-static/dist/**/*",
      "!node_modules/madden-franchise/data/schemas/{19,20,21,22,23,24,25,26}/**/*",
      "!node_modules/madden-franchise/data/schemas/27/M27_525_0.gz",
      "package.json"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "icon": "assets/icon.png"
    }
  },
  "dependencies": {
    "lucide-static": "^1.23.0",
    "madden-franchise": "^4.3.0"
  },
  "devDependencies": {
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3"
  }
}
